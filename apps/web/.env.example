# AeroRoute Web — environment variables
# Copy to apps/web/.env.local

# --- Required ---
# Modal / local FastAPI URL (used by server components and the /api/backend proxy)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional server-only alias (Vercel); falls back to NEXT_PUBLIC_API_URL
# API_URL=https://your-modal-url.modal.run

# --- Clerk (required for login) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Optional ---
NEXT_PUBLIC_APP_ENV=development
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
