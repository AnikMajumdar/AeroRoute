SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CLERK_SECRET_KEY=sk_test_your-clerk-secret
# Optional: Clerk JWKS URL for JWT validation (e.g. https://your-clerk-domain/.well-known/jwks.json)
CLERK_JWKS_URL=
API_CORS_ORIGINS=http://localhost:3000
# AeroRoute Copilot (Google Gemini — required for LLM chat)
COPILOT_ENABLED=false
GEMINI_API_KEY=
# Optional model override (default: gemini-2.0-flash; also try gemini-2.0-flash-lite for lower cost)
GEMINI_MODEL=gemini-2.5-flash-lite
