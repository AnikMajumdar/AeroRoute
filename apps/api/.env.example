# AeroRoute API — environment variables
# Copy to apps/api/.env and fill in required values.

# --- Required (app will not work without these) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Clerk authentication ---
# The API verifies Clerk JWTs against the instance JWKS and fails closed (503) without one.
# Either set CLERK_JWKS_URL (Clerk Dashboard -> API Keys -> Advanced -> JWKS URL) or provide the publishable key
# (same value as the web app's NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY) and the URL is derived from it.
CLERK_JWKS_URL=
CLERK_PUBLISHABLE_KEY=
# Optional: when set, the token `iss` claim must match exactly (e.g. https://clerk.example.com, no trailing slash).
CLERK_ISSUER=
# Local development only: trust the X-User-Id header when no JWKS is available. Ignored when a JWKS is
# configured and always ignored when APP_ENV=production.
ALLOW_DEV_AUTH_HEADER=false
# No longer used by the API.
CLERK_SECRET_KEY=

# --- Server ---
# Comma-separated browser origins (add your Vercel URL for direct API calls from the browser)
API_CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
APP_ENV=development
LOG_LEVEL=INFO

# --- AeroRoute Copilot (optional) ---
# Copilot runs on the Modal API — set these in Modal secret aeroroute-secrets, NOT on Vercel.
COPILOT_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Aviation weather (DISABLED — no API calls in current build) ---
# AviationWeather.gov is typically public; leave blank until you re-enable integration.
AVIATION_WEATHER_ENABLED=false
AVIATION_WEATHER_API_BASE_URL=

# --- FAA live data (DISABLED — no API calls in current build) ---
FAA_INTEGRATIONS_ENABLED=false
FAA_NAS_STATUS_URL=
NOTAM_PROVIDER_MODE=disabled
FAA_NMS_API_BASE_URL=
FAA_NMS_API_KEY=
FAA_NMS_CLIENT_ID=
FAA_NMS_CLIENT_SECRET=
