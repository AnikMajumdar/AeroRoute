# AeroRoute API — environment variables
# Copy to apps/api/.env and fill in required values.

# --- Required (app will not work without these) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Clerk authentication ---
CLERK_SECRET_KEY=
# Optional but recommended for production JWT validation:
CLERK_JWKS_URL=
CLERK_ISSUER=

# --- Server ---
# Comma-separated browser origins (add your Vercel URL for direct API calls from the browser)
API_CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
APP_ENV=development
LOG_LEVEL=INFO

# --- AeroRoute Copilot (optional) ---
COPILOT_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Aviation weather (DISABLED — no API calls in current build) ---
# AviationWeather.gov is typically public; leave blank until you re-enable integration.
AVIATION_WEATHER_ENABLED=false
AVIATION_WEATHER_API_BASE_URL=

# --- FAA live data (DISABLED — no API calls in current build) ---
FAA_INTEGRATIONS_ENABLED=false
FAA_NAS_STATUS_URL=
NOTAM_PROVIDER_MODE=disabled
FAA_NMS_API_BASE_URL=
FAA_NMS_API_KEY=
FAA_NMS_CLIENT_ID=
FAA_NMS_CLIENT_SECRET=
